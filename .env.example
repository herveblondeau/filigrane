# Port the frontend/nginx container publishes on the host
FRONTEND_PORT=80

# Workflow Main.Api the nginx proxy forwards /api/* to.
# On Linux, host.docker.internal resolves to the host (see docker-compose.yml).
WORKFLOW_API_URL=http://host.docker.internal:8080

# Must match Main.Api's API_KEY. nginx injects it as X-Api-Key server-side,
# so the browser never sees it. Required (compose fails fast if unset).
WORKFLOW_API_KEY=
