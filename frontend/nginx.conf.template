worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    # --- Rate limiting zones ---
    limit_req_zone $binary_remote_addr zone=watermark_zone:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=download_zone:10m  rate=20r/m;
    limit_req_zone $binary_remote_addr zone=api_zone:10m       rate=60r/m;

    server {
        listen 80;
        server_name _;

        client_max_body_size 4M;

        # --- Static frontend ---
        root /usr/share/nginx/html;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        # --- Watermark upload (most restricted) ---
        location = /api/watermark {
            limit_req zone=watermark_zone burst=2 nodelay;
            limit_req_status 429;

            proxy_pass         ${WORKFLOW_API_URL};
            # Works for both a plain-HTTP same-network upstream and an HTTPS
            # domain upstream: send SNI + the upstream's own Host, not the
            # browser's, so TLS/vhost matching on the remote proxy succeeds.
            proxy_ssl_server_name on;
            proxy_set_header   Host              $proxy_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Api-Key         "${WORKFLOW_API_KEY}";
            proxy_read_timeout 120s;
            proxy_send_timeout 30s;
        }

        # --- Download (single-use links) ---
        location ~ ^/api/download/ {
            limit_req zone=download_zone burst=5 nodelay;
            limit_req_status 429;

            proxy_pass         ${WORKFLOW_API_URL};
            proxy_ssl_server_name on;
            proxy_set_header   Host              $proxy_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Api-Key         "${WORKFLOW_API_KEY}";
            proxy_buffering    off;
            proxy_read_timeout 60s;
        }

        # --- Everything else under /api (health, etc.) ---
        location /api/ {
            limit_req zone=api_zone burst=10 nodelay;
            limit_req_status 429;

            proxy_pass         ${WORKFLOW_API_URL};
            proxy_ssl_server_name on;
            proxy_set_header   Host              $proxy_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Api-Key         "${WORKFLOW_API_KEY}";
        }
    }
}
