{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Filigrane": {
    "StoragePath": "/app/storage",
    "TokenExpiryHours": 4,
    "CleanupIntervalMinutes": 30,
    "MaxFileSizeBytes": 3145728
  },
  "RateLimiting": {
    "WatermarkPermitLimit": 5,
    "WatermarkWindowSeconds": 60,
    "DownloadPermitLimit": 20,
    "DownloadWindowSeconds": 60
  }
}
